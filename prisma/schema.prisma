generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  passwordHash        String
  name                String
  role                String            @default("user")
  avatarMime          String?
  avatarData          Bytes?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  favorites           Favorite[]
  follows             Follow[]
  presence            PresenceSession[]
  submissions         MocSubmission[]   @relation("MocSubmitter")
  reviewedSubmissions MocSubmission[]   @relation("MocReviewer")
  reviewNotes         MocReviewNote[]
}

model Creator {
  id          String     @id @default(cuid())
  slug        String     @unique
  displayName String
  bio         String     @default("")
  avatarPath  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  followers   Follow[]
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  priceCents       Int
  description      String
  imagesJson       String         @default("[]")
  youtubeUrl       String?
  downloadFilePath String?
  isActive         Boolean        @default(true)
  creatorId        String
  mocSubmissionId  String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creator          Creator        @relation(fields: [creatorId], references: [id])
  mocSubmission    MocSubmission? @relation(fields: [mocSubmissionId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  favorites        Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Follow {
  id             String   @id @default(cuid())
  followerUserId String
  creatorId      String
  createdAt      DateTime @default(now())
  follower       User     @relation(fields: [followerUserId], references: [id], onDelete: Cascade)
  creator        Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerUserId, creatorId])
}

model PresenceSession {
  id         String   @id @default(cuid())
  sessionKey String   @unique
  userId     String?
  lastSeenAt DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Order {
  id              String      @id @default(cuid())
  email           String
  status          String      @default("pending")
  stripeSessionId String?     @unique
  totalCents      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int             @default(1)
  priceCents     Int
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  downloadTokens DownloadToken[]
}

model DownloadToken {
  id            String    @id @default(cuid())
  token         String    @unique
  orderItemId   String
  expiresAt     DateTime
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

model MocSubmission {
  id                   String          @id @default(cuid())
  mocName              String
  theme                String
  builderName          String          @default("")
  builderEmail         String          @default("")
  submitterUserId      String?
  photoPathsJson       String          @default("[]")
  instructionPathsJson String          @default("[]")
  notes                String?
  youtubeUrl           String?
  status               String          @default("new")
  reviewedAt           DateTime?
  reviewedByUserId     String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  submitter            User?           @relation("MocSubmitter", fields: [submitterUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?           @relation("MocReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes          MocReviewNote[]
  product              Product?
}

model MocReviewNote {
  id           String        @id @default(cuid())
  submissionId String
  authorUserId String?
  authorLabel  String
  body         String
  decision     String?
  emailed      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  submission   MocSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
